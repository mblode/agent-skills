{
  "name": "fathom-tokens",
  "version": "0.9.4",
  "description": "Spacing, type and colour tokens for Fathom products",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && node scripts/publish-bundle.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
