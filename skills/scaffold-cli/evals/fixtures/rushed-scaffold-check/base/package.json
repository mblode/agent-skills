{
  "name": "marten-feeds",
  "version": "0.0.1",
  "description": "{{description}}",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "marten": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "keywords": [],
  "author": "Ines Varga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollowpine/marten-feeds.git"
  },
  "homepage": "https://github.com/hollowpine/marten-feeds#readme",
  "bugs": {
    "url": "https://github.com/hollowpine/marten-feeds/issues"
  },
  "engines": {
    "node": ">=24.11"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
