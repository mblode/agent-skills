{
  "name": "larch-tasks",
  "version": "3.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "check": "tsc --noEmit && biome check src",
    "test": "vitest run",
    "migrate:local": "node scripts/migrate.mjs --target .tmp/dev.sqlite",
    "migrate:shared": "node scripts/migrate.mjs --target \"$SHARED_DATABASE_URL\""
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
